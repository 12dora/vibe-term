{
  "name": "vibeterm-cli",
  "version": "2.2.4",
  "type": "module",
  "license": "MIT",
  "bin": {
    "vibeterm": "./bin/vibeterm.js",
    "tmex": "./bin/tmex.js",
    "vibeterm-cli": "./bin/vibeterm.js"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/12dora/vibe-term.git"
  },
  "files": [
    "bin",
    "dist",
    "resources",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "rm -rf dist resources/fe-dist resources/gateway-drizzle",
    "bundle:resources": "bash ./scripts/bundle-resources.sh",
    "build:runtime": "bun scripts/build-runtime.ts",
    "build:artifacts": "bun scripts/build-artifacts.ts",
    "build:cli": "bun build src/cli-node.ts --outfile ./dist/cli-node.js --target node --format esm --packages bundle && bun run build:client-cli",
    "build:client-cli": "bun build ../cli/src/main.ts --outfile ./dist/cli.js --target node --format esm --packages bundle",
    "build": "bun run clean && bun run bundle:resources && bun run build:runtime && bun run build:cli",
    "pack": "npm pack",
    "test": "bun test src"
  },
  "dependencies": {
    "@peculiar/x509": "1.14.3",
    "acme-client": "^5.4.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "node-datachannel": "0.33.1",
    "typescript": "^5.7.3"
  }
}
