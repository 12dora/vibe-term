{
  "name": "vibeterm",
  "private": true,
  "license": "MIT",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bash ./scripts/dev-supervisor.sh",
    "notify:demo": "bash ./scripts/notify-demo.sh",
    "build": "bun run build:i18n && bun run build:fe && bun run build:app:resources && bun run build:app",
    "build:i18n": "bun run --filter @vibeterm/shared build:i18n",
    "build:fe": "bun run --filter @vibeterm/fe build",
    "build:app:resources": "bun run --filter vibeterm-cli bundle:resources",
    "build:app:runtime": "bun run --filter vibeterm-cli build:runtime",
    "build:app": "bun run --filter vibeterm-cli build",
    "build:app:cli": "bun run --filter vibeterm-cli build:cli",
    "build:artifacts": "bun packages/app/scripts/build-artifacts.ts",
    "build:fonts": "bun scripts/fonts/build-fonts.ts",
    "build:theme-presets": "bun scripts/theme/build-theme-presets.ts",
    "release": "bun scripts/release.ts",
    "pack": "bun run build && bun run --filter vibeterm-cli pack",
    "test": "bun run --filter '*' test",
    "test:unit": "bun scripts/ci/unit-tests.ts",
    "test:app": "bun run --filter vibeterm-cli test",
    "lint": "biome check . && bun scripts/complexity/gate.ts",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "bun-types": "^1.3.12",
    "subset-font": "^2.7.0",
    "typescript": "^5.7.3",
    "wawoff2": "^2.0.1"
  }
}
