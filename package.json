{
  "name": "tmex",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bash ./scripts/dev-supervisor.sh",
    "notify:demo": "bash ./scripts/notify-demo.sh",
    "build": "bun run build:i18n && bun run build:fe && bun run build:tmex:resources && bun run build:tmex",
    "build:i18n": "bun run --filter @tmex/shared build:i18n",
    "build:fe": "bun run --filter @tmex/fe build",
    "build:tmex:resources": "bun run --filter tmex-cli bundle:resources",
    "build:tmex:runtime": "bun run --filter tmex-cli build:runtime",
    "build:tmex": "bun run --filter tmex-cli build",
    "build:tmex:cli": "bun run --filter tmex-cli build:cli",
    "build:artifacts": "bun packages/app/scripts/build-artifacts.ts",
    "build:fonts": "bun scripts/fonts/build-fonts.ts",
    "build:theme-presets": "bun scripts/theme/build-theme-presets.ts",
    "release:tmex": "bun scripts/release.ts",
    "pack:tmex": "bun run build && bun run --filter tmex-cli pack",
    "test": "bun run --filter '*' test",
    "test:tmex": "bun run --filter tmex-cli test",
    "lint": "biome check . && bun scripts/complexity/gate.ts",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "bun-types": "^1.3.12",
    "typescript": "^5.7.3",
    "wawoff2": "^2.0.1"
  }
}
