# VibeTerm 开发环境变量（NODE_ENV=development）
# 由应用启动时经 @vibeterm/shared loadEnv() 自动加载。
# 个人临时覆盖请写 development.env.local（已 gitignore）。

NODE_ENV=development

# 主密钥（32 bytes base64）——开发用公开 key，勿用于生产
VIBETERM_MASTER_KEY=tGd9gPmdUkJrpRQK+db60sc+NkxymxgGqKrReDU4Kus=
VIBETERM_SITE_NAME=VibeTerm

# 端口沿用 19663/19883，避开本机常驻生产实例的 9663/9883
GATEWAY_PORT=19663
FE_PORT=19883

# 相对路径会被 loadEnv 解析到仓库根
DATABASE_URL=./vibeterm.db
VIBETERM_BIND_HOST=127.0.0.1
VIBETERM_BASE_URL=http://127.0.0.1:19663
VIBETERM_GATEWAY_URL=http://localhost:19663

# 以下显式值需与 apps/gateway/src/config.ts 的默认值保持一致
VIBETERM_BELL_THROTTLE_SECONDS=6
VIBETERM_NOTIFICATION_THROTTLE_SECONDS=3
VIBETERM_DISABLED_NOTIFICATION_CHANNELS=
VIBETERM_TMUX_ALLOW_PASSTHROUGH=false
VIBETERM_TMUX_TERM_PROGRAM=ghostty
VIBETERM_TMUX_WINDOW_STYLE=fg=#d0d0d0,bg=#262626
VIBETERM_SSH_RECONNECT_MAX_RETRIES=2
VIBETERM_SSH_RECONNECT_DELAY_SECONDS=10
VIBETERM_DEFAULT_LANGUAGE=en_US
